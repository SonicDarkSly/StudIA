{
  "name": "studia",
  "private": true,
  "version": "1.0.0",
  "description": "StudIA : chat IA 100 % local pour fabriquer des skills, connecteurs MCP, commandes, sous-agents, CLAUDE.md et hooks à partir de ses propres projets.",
  "author": "SonicDarkSly (https://github.com/SonicDarkSly)",
  "license": "Apache-2.0",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w server && npm run build -w client",
    "format": "prettier --write \"server/src/**/*.ts\" \"client/src/**/*.{ts,tsx,css}\" scripts \"tests/**/*.ts\" eslint.config.mjs vitest.config.mts",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit && tsc -p tests/tsconfig.json",
    "lint": "eslint .",
    "a11y": "node scripts/audit-a11y.mjs",
    "test": "vitest run",
    "format:check": "prettier --check \"server/src/**/*.ts\" \"client/src/**/*.{ts,tsx,css}\" scripts \"tests/**/*.ts\" eslint.config.mjs vitest.config.mts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "axe-core": "^4.14.0",
    "concurrently": "^9.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "minimatch": "^11.0.3",
    "node-llama-cpp": {
      "simple-git": "4.0.2"
    }
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "node-llama-cpp@3.22.2": true
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": "prettier --write"
  }
}
